# Book Wagon Server - Environment Variables Example
#
# Copy this file to .env and fill in your actual credentials
# cp .env.example .env

# ============================================================================
# Server Configuration
# ============================================================================

# Server port (default: 8000)
PORT=8000

# Environment mode: development, production, or test
NODE_ENV=development


# ============================================================================
# Database Configuration
# ============================================================================

# MongoDB connection string
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?appName=book-wagon
#
# How to get:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a cluster and database user
# 3. Click "Connect" → "Drivers" → Copy connection string
# 4. Replace <username>, <password>, and <database-name>
MONGODB_URI=your_mongodb_connection_string


# ============================================================================
# Firebase Authentication
# ============================================================================

# Base64-encoded Firebase service account JSON
#
# How to get:
# 1. Go to https://console.firebase.google.com
# 2. Select your project → Settings → Service Accounts
# 3. Click "Generate New Private Key"
# 4. Encode to base64: cat serviceAccountKey.json | base64
# 5. Paste the base64 string here
FIREBASE_SERVICE_KEY=base64_encoded_service_account_json


# ============================================================================
# Stripe Payment Gateway
# ============================================================================

# Stripe secret key for server-side payment processing
# Use sk_test_* for development, sk_live_* for production
#
# How to get:
# 1. Go to https://dashboard.stripe.com
# 2. Navigate to Developers → API Keys
# 3. Copy your Secret Key (starts with sk_test_ or sk_live_)
PAYMENT_GATEWAY_SECRET_KEY=your_stripe_secret_key


# ============================================================================
# Frontend Configuration
# ============================================================================

# Frontend application URL (used for CORS and redirects)
# For development: http://localhost:3000 or http://localhost:5173 (Vite)
# For production: https://yourdomain.com
SITE_DOMAIN=http://localhost:3000
